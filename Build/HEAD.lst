 0001           ; #endif // PDO_IN_OD
 0001           ; 
 0001           ;   // End-of-table marker
 0001           ;   SDOREPLY(0xFFFF, 0xFF, 0xFF, 0xFFFFFFFFL)
 0001           ; };
